# ATTENDORA Environment Configuration
# Copy this to .env and configure

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendora
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/attendora

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=ATTENDORA
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.45
FACE_RECOGNITION_MODEL=hog
MIN_FACE_CONFIDENCE=0.6

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Super Admin (created on first run)
SUPER_ADMIN_EMAIL=admin@attendora.com
SUPER_ADMIN_PASSWORD=Admin@12345
